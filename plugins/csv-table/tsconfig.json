{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "noEmit": true,
    "skipLibCheck": false
  },
  "exclude": ["node_modules", "dist", "**/._*"],
  "include": [
    "server.ts",
    "app.tsx",
    "contract.ts",
    "csv.ts",
    "csv-view.ts",
    "csv-table.tsx",
    "open-target.ts",
    "components",
    "lib",
    "hooks",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
